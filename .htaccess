# alleskonverter.de — Serverkonfiguration (Apache)

# ----- Eigene Fehlerseite -----
ErrorDocument 404 /404.html

# ----- Kanonische Adresse: www entfernen -----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# ----- Kompression -----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
  # WASM lohnt sich besonders (ffmpeg-Kern)
  AddOutputFilterByType DEFLATE application/wasm
</IfModule>

# ----- Zwischenspeicher im Browser -----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 week"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType text/javascript           "access plus 1 year"
  ExpiresByType application/wasm          "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType image/png                 "access plus 6 months"
  ExpiresByType image/jpeg                "access plus 6 months"
  ExpiresByType image/webp                "access plus 6 months"
  ExpiresByType image/svg+xml             "access plus 6 months"
  ExpiresByType image/x-icon              "access plus 6 months"
  ExpiresByType application/manifest+json "access plus 1 day"
</IfModule>

# ----- Was sich ändern kann, muss geprüft werden -----
# mod_expires setzt oben pauschale Zeiten; eigener Code darf davon nicht erfasst
# werden, sonst sehen wiederkehrende Besucher nach einem Deploy altes CSS/JS.
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/(css|js)/"                 EIGENER_CODE
  SetEnvIf Request_URI "^/tools/[^/]+/(css|js)/"     EIGENER_CODE
  SetEnvIf Request_URI "^/(sw\.js|manifest\.webmanifest)$" EIGENER_CODE
  SetEnvIf Request_URI "^/assets/"                   EIGENE_BILDER
</IfModule>

<IfModule mod_headers.c>
  # Eigener Code: nie ungeprüft aus dem Cache. Der Browser fragt mit ETag nach und
  # bekommt in aller Regel ein winziges „304 unverändert“ zurück.
  Header set Cache-Control "no-cache, must-revalidate" env=EIGENER_CODE
  # mod_expires setzt oben pauschal ein Jahr — dieser Rest widerspräche dem no-cache
  Header unset Expires env=EIGENER_CODE
  Header always set Expires "Thu, 01 Jan 1970 00:00:00 GMT" env=EIGENER_CODE
  # Eigene Bilder ändern sich selten, sollen aber nicht monatelang festhängen
  Header set Cache-Control "public, max-age=86400, must-revalidate" env=EIGENE_BILDER

  # HTML immer frisch holen, damit Änderungen sofort ankommen
  <FilesMatch "\.(html|json|xml|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Der Service Worker steuert alles andere — er selbst darf nie veralten
  <Files "sw.js">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Service-Worker-Allowed "/"
  </Files>
  # Unveränderliche Fremdbibliotheken und Schriften lange behalten
  <FilesMatch "\.(woff2|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # ----- Sicherheitskopfzeilen -----
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
</IfModule>

# ----- MIME-Typen, die Strato nicht von Haus aus kennt -----
<IfModule mod_mime.c>
  AddType application/wasm            .wasm
  AddType application/manifest+json   .webmanifest
  AddType font/woff2                  .woff2
  AddType image/webp                  .webp
</IfModule>

# ----- Verzeichnislisten aus -----
Options -Indexes
